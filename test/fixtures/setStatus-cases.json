{
  "cases": [
    {
      "name": "valid",
      "body": {
        "action": "setStatus",
        "id": "20261003-cdef",
        "status": "building",
        "rev": 2,
        "requestId": "req-0001"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "stale rev",
      "body": {
        "action": "setStatus",
        "id": "20261003-cdef",
        "status": "building",
        "rev": 1,
        "requestId": "req-0001"
      },
      "expect": {
        "status": 409,
        "code": "STALE"
      }
    },
    {
      "name": "unknown id",
      "body": {
        "action": "setStatus",
        "id": "20260101-zzzz",
        "status": "done",
        "rev": 1,
        "requestId": "req-0001"
      },
      "expect": {
        "status": 400,
        "code": "UNKNOWN_CARD"
      }
    },
    {
      "name": "bad status",
      "body": {
        "action": "setStatus",
        "id": "20261003-cdef",
        "status": "shipped",
        "rev": 2,
        "requestId": "req-0001"
      },
      "expect": {
        "status": 400,
        "code": "BAD_STATUS"
      }
    },
    {
      "name": "extra key",
      "body": {
        "action": "setStatus",
